formula.Y="Y ~ C+X+Z*W+I((1-X)*(1-Z)*(1-W))", formula.X="X ~ W+Z:W", formula.Z="Z~.",
linkY_binary="logit", link.X="identity", link.Z="logit",
truncate_lower.X=0, truncate_upper.X=1,
