mean(EIF.W)
EIF.W <- Reduce(`+`, lapply(1:n, function(i) f.x.z(x, Z[i], truncate_lower.X, truncate_upper.X)/phi2[i]*(f.mu.xz(x, Z[i]) - plugin.est)    ))
EIF.W <- Reduce(`+`, lapply(1:n, function(i) f.x.z(x, Z[i], truncate_lower.X, truncate_upper.X)/phi2[i]*(f.mu.xz(x, Z[i]) - plugin.est[i])    ))
