p.z0.tmle <- plot.tmle(r'($\psi(\hat{Q}^*;z=0)$)',z="z0")
p.all.z.tmle <- plot.tmle(r'($\psi(\hat{Q}^*;Z)$)',z="all.z")
## bayes-onestep====
load("Onestep/result.Rdata")
p.z1.one <- plot.tmle(r'($\psi^{+}(\hat{Q};z=1)$)',z="z1")
p.z0.one <- plot.tmle(r'($\psi^{+}(\hat{Q};z=0)$)',z="z0")
p.all.z.one <- plot.tmle(r'($\psi^{+}(\hat{Q};Z)$)',z="all.z")
p.tmle <- plot_grid(
p.z0.tmle,p.z1.tmle,p.all.z.tmle,
align = "v", ncol = 1
)
p.one <- plot_grid(
p.z0.one,p.z1.one,p.all.z.one,
align = "v", ncol = 1
)
p.final <- plot_grid(
p.tmle,p.one,
align = "h",
ncol = 2
)
ggsave("plot.pdf", plot = p.final, width = 16, height = 18, units = "in")
mean(EIF^2)
mean(EIF.t^2)
# mean{E(Y|X,Z,W,C)*p(X|Z,W,C)}
phi1.t <- mean(f.phi1.z(x,z))
# mean{p(X|Z,W,C)}
phi2.t <- mean(f.phi2.z(x,z))
psi.t <- phi1.t/phi2.t
mu.y.xzwC.t <- E.y.lmax(Y.binary, parY, x = x, z = z, w=W, C) # outcome regression
p.z.t <- density.z.wc(Z.binary, parZ, z = z, W, C) # density of z
p.x.zWC.t <- density.x.zwc(parX, x = x, z = z, w=W) # p(X=x|Z=z,W,C)
EIF.Y.t <- (X==x)*(Z==z)/{phi2.t*p.z.t}*{Y-mu.y.xzwC.t}
EIF.X.t <- (Z==z)/{(phi2.t*p.z.t)}*{mu.y.xzwC.t-psi.t}*{(X==x) - p.x.zWC.t}
EIF.W.t <- (1/phi2.t) *{mu.y.xzwC.t*p.x.zWC.t-psi.t*p.x.zWC.t}
EIF.t <- EIF.Y.t + EIF.X.t + EIF.W.t
mean(EIF.t^2)
mean(EIF.t^2);mean(EIF^2)
